node_modules/
dist/
src-tauri/target/
src-tauri/gen/
rustup-init.exe
vs_buildtools.exe
vite.config.ts.timestamp-*.mjs
ghcli/
gh.zip
node-win.zip
# 随包资源由 scripts/setup-resources.sh 生成（Node 便携版 + dsh，上百 MB）。
# 只留一个 README 占位：bundle.resources 的 glob 在 tauri-build 阶段
# （即编译期）就会校验，目录完全不存在会让 cargo check / cargo test
# 直接失败，任何人 clone 后都编不过。
resources/*
!resources/README.md
dsh-pkg.zip
.npm-cache/
*.log
.DS_Store

# UI 端到端验证（scripts/verify-ui.mjs）的产物：截图、报告、临时浏览器配置
.verify-ui/

# 构建产物若被手动拷到根目录，不要误提交
*-setup.exe
*-setup.zip
# 第三方商标与图形一律不入库（本项目不宣称官方隶属关系）
deepseek-logo.png
deepseek-*.svg

# 密钥与环境变量严禁入库
.env
.env.*
*.pem
*.key
# 本地数据库与临时文件
*.db
*.db-journal
*.sqlite
*.sqlite3
